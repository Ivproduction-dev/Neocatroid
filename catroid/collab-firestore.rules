rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isMember(sid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/collabSessions/$(sid)/members/$(request.auth.uid));
    }
    function isOwner(sid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/collabSessions/$(sid)/meta/meta).data.ownerUid == request.auth.uid;
    }
    match /collabSessions/{sid}/meta/meta {
      allow read: if isMember(sid);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(sid);
      allow delete: if false;
    }

    match /collabSessions/{sid}/members/{uid} {
      allow get: if isMember(sid);
      allow list: if isMember(sid);
      allow create, update: if isOwner(sid)
        && request.resource.data.role in ['host', 'editor', 'viewer'];
      allow delete: if isOwner(sid) && uid != request.auth.uid;
    }

    match /collabSessions/{sid}/invites/{code} {
      allow get: if isSignedIn();
      allow list: if isMember(sid);
      allow create: if isOwner(sid);
      allow update: if isSignedIn()
        && resource.data.usedBy == ''
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.role == resource.data.role
        && resource.data.expiresAt > request.time.toMillis()
        && get(/databases/$(database)/documents/collabSessions/$(sid)/meta/meta).data.closed == false;
      allow delete: if isOwner(sid);
    }

    match /collabSessions/{sid}/requests/{uid} {
      allow read: if isOwner(sid);
      allow create: if isSignedIn() && uid == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(sid);
    }

    match /collabSessions/{sid}/presence/{uid} {
      allow read: if isMember(sid);
      allow write: if isMember(sid) && uid == request.auth.uid;
      allow delete: if (isMember(sid) && uid == request.auth.uid) || isOwner(sid);
    }

    // Advisory per-event edit locks. TTL is enforced by clients on claim;
    // rules only bind rows to their owners. Git history stays the real arbiter.
    match /collabSessions/{sid}/locks/{scriptId} {
      allow read: if isMember(sid);
      allow create, update: if isMember(sid)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember(sid)
        && (resource.data.uid == request.auth.uid || isOwner(sid));
    }

    // P1 gateway sync: guests upload patches, host publishes states.
    // Chunks are written after their parent doc; parent authorship is re-checked.
    match /collabSessions/{sid}/patches/{pid} {
      allow read: if isMember(sid);
      allow create: if isMember(sid)
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if false;
      allow delete: if isMember(sid)
        && (resource.data.fromUid == request.auth.uid || isOwner(sid));

      match /chunks/{cid} {
        allow read: if isMember(sid);
        allow create: if isMember(sid)
          && get(/databases/$(database)/documents/collabSessions/$(sid)/patches/$(pid)).data.fromUid == request.auth.uid;
        allow update: if false;
        allow delete: if isMember(sid);
      }
    }

    match /collabSessions/{sid}/states/{stid} {
      allow read: if isMember(sid);
      allow create, update: if isOwner(sid);
      // Members may consume states (guest deletes a fully downloaded snapshot);
      // the host republishes on every change, so a deleted state heals itself.
      allow delete: if isMember(sid);

      match /chunks/{cid} {
        allow read: if isMember(sid);
        allow create, update, delete: if isOwner(sid);
      }
    }

    // Full-project bootstrap for guests without the project.
    match /collabSessions/{sid}/snapshotRequests/{uid} {
      allow read, delete: if isOwner(sid);
      allow create: if isMember(sid) && uid == request.auth.uid;
      allow update: if false;
    }
  }
}
