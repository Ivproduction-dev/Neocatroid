<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_modify_light_2d_layout"
        style="@style/BrickContainer.Look.Medium">

        <include layout="@layout/icon_brick_category_light2d" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_light_2d_modify_title" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_light_2d_modify_property"
            app:layout_newLine="true" />
        <Spinner
            android:id="@+id/brick_modify_light_2d_property_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_light_2d_modify_light"
            app:layout_newLine="true" />
        <TextView
            android:id="@+id/brick_modify_light_2d_name"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_light_2d_modify_object"
            app:layout_newLine="true" />
        <TextView
            android:id="@+id/brick_modify_light_2d_object"
            style="@style/BrickEditText" />

        <TextView
            android:id="@+id/brick_modify_light_2d_label_x"
            style="@style/BrickText.SingleLine"
            android:text="X:"
            app:layout_newLine="true" />
        <TextView
            android:id="@+id/brick_modify_light_2d_x"
            style="@style/BrickEditText" />

        <TextView
            android:id="@+id/brick_modify_light_2d_label_y"
            style="@style/BrickText.SingleLine"
            android:text="Y:" />
        <TextView
            android:id="@+id/brick_modify_light_2d_y"
            style="@style/BrickEditText" />

        <TextView
            android:id="@+id/brick_modify_light_2d_label_value"
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_light_2d_control_value"
            app:layout_newLine="true" />
        <TextView
            android:id="@+id/brick_modify_light_2d_value"
            style="@style/BrickEditText" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
