<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_udp_measure_ping_layout"
        style="@style/BrickContainer.Internet.Big">

        <include layout="@layout/icon_brick_category_internet" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_udp_measure_ping" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_connect_server2"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_udp_measure_ping_ip_edit"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_connect_server3" />

        <TextView
            android:id="@+id/brick_udp_measure_ping_port_edit"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_udp_ping_timeout"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_udp_measure_ping_timeout_edit"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_udp_measure_ping2"
            app:layout_newLine="true" />

        <Spinner
            android:id="@+id/brick_udp_measure_ping_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
