<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_change_session_variable_layout"
        style="@style/BrickContainer.Data.Medium">

        <include layout="@layout/icon_brick_category_data" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_change_session_variable" />

        <TextView
            android:id="@+id/brick_session_variable_edit_name"
            style="@style/BrickEditText"
            app:layout_newLine="true" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_session_variable_value"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_session_variable_edit_value"
            style="@style/BrickEditText" />
    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
