<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_neo_play_3d_sound_at_camera_layout"
        style="@style/BrickContainer.Threed.Big">

        <include layout="@layout/icon_brick_category_neo3d" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_neo_play_3d_sound_at_camera" />

        <Spinner
            android:id="@+id/brick_neo_play_sound_camera_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_newLine="true" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_neo_volume"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_neo_play_sound_camera_edit_volume"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_neo_tone"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_neo_play_sound_camera_edit_tone"
            style="@style/BrickEditText" />

        <Spinner
            android:id="@+id/brick_neo_play_sound_camera_loop_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_newLine="true" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_neo_max_distance"
            app:layout_newLine="true" />

        <TextView
            android:id="@+id/brick_neo_play_sound_camera_edit_max_distance"
            style="@style/BrickEditText" />
    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
