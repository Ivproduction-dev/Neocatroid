<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_neo_stop_3d_sound_layout"
        style="@style/BrickContainer.Threed.Small">

        <include layout="@layout/icon_brick_category_neo3d" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_neo_stop_3d_sound" />

        <Spinner
            android:id="@+id/brick_neo_stop_sound_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_newLine="true" />
    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
