<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pocketpaint_chip_selected_background_color" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/pocketpaint_color_picker_purple1" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/pocketpaint_color_picker_purple2">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/pocketpaint_surface_nav" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
