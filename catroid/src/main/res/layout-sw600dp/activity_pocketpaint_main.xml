<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/pocketpaint_drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/pocketpaint_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/pocketpaint_main_drawing_surface_background"
        android:fitsSystemWindows="true">

        <include
            android:id="@+id/pocketpaint_layout_top_bar"
            layout="@layout/pocketpaint_layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pocketpaint_main_top_bar_height" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ScrollView
                android:id="@+id/paintroid_ui2_tool_rail_scroll"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:background="@color/pocketpaint_surface_nav"
                android:fillViewport="true"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/paintroid_ui2_tool_rail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <org.catrobat.catroid.paintroid.ui.DrawingSurface
                    android:id="@+id/pocketpaint_drawing_surface_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/pocketpaint_main_drawing_surface_active" />
<include
                    layout="@layout/pocketpaint_layout_zoom_window"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <androidx.core.widget.ContentLoadingProgressBar
                    android:id="@+id/pocketpaint_content_loading_progress_bar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/pocketpaint_main_bottom_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="@color/pocketpaint_surface_elevated"
                    android:visibility="gone">
                    <include layout="@layout/pocketpaint_layout_bottom_bar" />
                </LinearLayout>
            </FrameLayout>

            <include
                layout="@layout/pocketpaint_layout_tool_options"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:background="@color/pocketpaint_surface_elevated" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pocketpaint_main_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/pocketpaint_surface_nav">
            <include layout="@layout/pocketpaint_layout_bottom_navigation" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/pocketpaint_nav_view_layer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/pocketpaint_surface_elevated"
        android:clickable="true"
        android:focusable="true">
        <include
            layout="@layout/pocketpaint_layout_main_menu_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.navigation.NavigationView>

    </androidx.drawerlayout.widget.DrawerLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>




